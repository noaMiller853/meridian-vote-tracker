<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating version (latest, previews included) so the first build works. After a successful build, replace it with the
         exact version that was restored (see obj/project.assets.json or the build log) to make builds repeatable. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="*-*" />
  </ItemGroup>

</Project>

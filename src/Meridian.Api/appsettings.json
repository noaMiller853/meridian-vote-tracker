{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "MemberStatesPath": ""
  },
  "FileStore": {
    "LocalRoot": "data/uploads"
  },
  "Imports": {
    "PollSeconds": 5,
    "ProgressIntervalMs": 1000,
    "CommandTimeoutSeconds": 900
  }
}

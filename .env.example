# Copy to .env (which is git-ignored) and adjust. Defaults work for local development.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Azure: leave empty for local development.
# Real values go in .env or dotnet user-secrets, never in Git.
# Blob Storage (docker-compose.blob.yml): the account's blob endpoint and the container. Not secret. The account allows only
# Microsoft Entra auth (no key, no connection string); the access token is set in the terminal, not here (README).
AZURE_BLOB_SERVICE_URI=
AZURE_BLOB_CONTAINER=
# Application Insights: when set, the API sends requests and logs (with the correlation id) to it; empty means off.
# Value: portal > the Application Insights resource > Overview > Connection String. Keep it only in .env.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Run against Azure Database for PostgreSQL (docker-compose.azure.yml). Leave empty for local development.
# Host: portal > the PostgreSQL server > Overview > Server name.
# User: this server uses Microsoft Entra authentication, so the user is your Entra account (name@tenant.onmicrosoft.com),
# not a server admin login. The password is a short-lived token (about 1 hour) from:
#   az account get-access-token --resource https://ossrdbms-aad.database.windows.net --query accessToken --output tsv
# Better not to save it in this file: set it in the terminal (see README).
AZURE_PG_HOST=
AZURE_PG_DB=postgres
AZURE_PG_USER=
AZURE_PG_PASSWORD=

# Copy to .env (which is git-ignored) and adjust. Defaults work for local development.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian_dev
POSTGRES_DB=meridian
POSTGRES_PORT=5432

# API connection string (local development only)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=meridian;Username=meridian;Password=meridian_dev

# Azure: leave empty for local development.
# Real values go in .env or dotnet user-secrets, never in Git.
AZURE_STORAGE_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
